PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/this-magic-moment?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="This Magic Moment <djadam@thismagicmomentnj.com>"
ADMIN_EMAIL=djadam@thismagicmomentnj.com

# Admin seed credentials (used only by seed script — run locally)
ADMIN_NAME=Adam Aronow
ADMIN_EMAIL_SEED=admin@thismagicmomentnj.com
ADMIN_PASSWORD=Admin@123456

# Frontend URL(s) for CORS — comma-separated for multiple domains
# Example: https://your-site.vercel.app,https://www.thismagicmomentnj.com
CLIENT_URL=https://your-frontend.vercel.app
